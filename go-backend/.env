# Environment Configuration
ENVIRONMENT=development
PORT=8080

# Database Configuration
DATABASE_URL=postgres://user:password@localhost/convin_voice_api?sslmode=disable

# Redis Configuration (for caching and rate limiting)
REDIS_URL=redis://localhost:6379

# JWT Configuration
JWT_SECRET=your-super-secret-jwt-key-change-this-in-production

# API Key Configuration
API_KEY_SECRET=your-super-secret-api-key-secret-change-this-in-production

# STT Service Configuration
STT_MODEL_PATH=/path/to/stt/model
STT_GPU_ENABLED=true

# TTS Service Configuration
TTS_MODEL_PATH=/path/to/tts/model
TTS_GPU_ENABLED=true

# File Upload Configuration
MAX_FILE_SIZE=52428800  # 50MB in bytes
UPLOAD_DIR=./uploads

# Rate Limiting Configuration
RATE_LIMIT_REQUESTS=100
RATE_LIMIT_WINDOW=3600  # 1 hour in seconds

# Logging Configuration
LOG_LEVEL=info
LOG_FORMAT=json
